#!/bin/bash
# Pre-push hook: block any HTML not in _live-pages.txt
# HTML files ship with their video — do not push early

MANIFEST="_live-pages.txt"
REPO_ROOT="$(git rev-parse --show-toplevel)"
ERRORS=0

cd "$REPO_ROOT" || exit 1

if [ ! -f "$MANIFEST" ]; then
  echo "ERROR: $MANIFEST not found — cannot verify approved pages"
  exit 1
fi

while IFS= read -r -d '' html_file; do
  # Get path relative to repo root
  rel_path="${html_file#./}"
  if ! grep -qxF "$rel_path" "$MANIFEST"; then
    echo "BLOCKED: $rel_path is not approved in $MANIFEST"
    ERRORS=$((ERRORS + 1))
  fi
done < <(find . -name "*.html" -not -path "./.git/*" -print0)

if [ "$ERRORS" -gt 0 ]; then
  echo ""
  echo "To deploy a new page: add it to $MANIFEST, then push."
  echo "Rule: HTML files ship with their video — not during pre-production."
  exit 1
fi

exit 0
